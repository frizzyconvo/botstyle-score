  {
   "id": "banter_lines",
   "label": "Stock banter lines (\"took you long enough\", \"I don't bite\u2026 much\")",
   "regex": "\\b(?:well, well(?:, well)?|look who(?:'s| is| finally)|took you long enough|didn't (?:anyone|your mother|they) ever tell you|you're (?:cute|adorable) when you|like what you see|don't get any ideas|i don't bite|you wound me|how (?:very )?(?:bold|brave|daring) of you|playing hard to get|is that so\\?|careful now|easy there)"
  },
  {
   "id": "playful_smirk",
   "label": "\"a playful/knowing smirk\"",
   "regex": "\\b(?:a|with a|her|his) (?:playful|teasing|mischievous|wry|lopsided|crooked|amused|devilish|sly) (?:smirk|grin|smile|glint|twinkle|lilt)"
  },
  {
   "id": "for_a_moment",
   "label": "\"for a moment / a heartbeat\"",
   "regex": "\\bfor (?:a|one) (?:moment|heartbeat|breath|beat|second|long moment)\\b"
  },
  {
   "id": "something_akin",
   "label": "\"something akin to / something like\"",
   "regex": "\\bsomething (?:akin to|between|close to|almost like)\\b"
  },
