{
  "name": "botstyle-score",
  "version": "0.20.1",
  "private": true,
  "description": "BB Botstyle Scorer: a character-card pseudo-fork of slop-score that reads how much a card leans on stock AI phrasing",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@msgpack/msgpack": "^3.1.2",
    "dotenv": "^17.2.3",
    "wink-pos-tagger": "^2.2.2"
  },
  "scripts": {
    "start": "node tools/serve.mjs",
    "test": "node tools/test.mjs",
    "score-all": "node tools/score_all.mjs",
    "leaderboard": "node tools/build_card_leaderboard.mjs",
    "reference": "node tools/build_reference.mjs",
