{
  "name": "botstyle-score",
  "version": "0.40.1",
  "description": "BB Botstyle Scorer: a character-card scorer derived from slop-score that reads how much a card leans on stock AI phrasing",
  "keywords": [
    "character-cards",
    "ai-writing",
    "slop",
    "sillytavern",
    "roleplay",
    "text-analysis"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/frizzyconvo/botstyle-score.git"
  },
  "homepage": "https://frizzyconvo.github.io/botstyle-score/",
  "bugs": {
    "url": "https://github.com/frizzyconvo/botstyle-score/issues"
  },
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "dotenv": "^18.0.9",
    "wink-pos-tagger": "^2.2.2"
  },
  "scripts": {
    "start": "node tools/serve.mjs",
    "test": "node tools/test.mjs",
    "score-all": "node tools/score_all.mjs",
    "leaderboard": "node tools/build_card_leaderboard.mjs",
    "reference": "node tools/build_reference.mjs",
    "score-path": "node tools/score_all.mjs --add",
    "results": "node tools/results.mjs",
    "shortcuts": "node tools/doc_shortcuts.mjs"
  }
}
